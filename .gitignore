# --- never commit these -------------------------------------------------
# The app signing key. Android identifies an app by its signature, so this
# file is the only thing that lets a new build install over an existing one
# and keep its data. Losing it means the board on the phone can never be
# updated again; publishing it means anyone can sign a build that Android
# will happily install over Chris's. Back it up somewhere private, not here.
aac.keystore

# The keystore password, read by build.sh.
.keystore-pass

# --- build output -------------------------------------------------------
build/
*.idsig

# Assembled by build.sh from index.html (and, in the v2.2 archive, from its
# assets/ directory). Regenerated on every build.
app/assets/
versions/*/app/assets/

# --- editor / OS noise --------------------------------------------------
.DS_Store
*~

# --- symbol_gen scratch (raw renders, untrimmed audio, logs) — ~2 GB -------
# Only the scripts, prompts and catalogues are tracked; outputs are rebuilt
# with gen_symbols.py / gen_audio.py / gen_phrases.py.
symbol_gen/raw/
symbol_gen/raw_old/
symbol_gen/audio_raw*/
symbol_gen/audio_mp3_*/
symbol_gen/canva_test/
symbol_gen/*.log
symbol_gen/*.bak
symbol_gen/__pycache__/

# Release APKs >50 MB go on GitHub Releases, not in history.
AAC-Board-v2.6.apk
